# Copy to .env.local for local testing. In production set these in
# Vercel → Project → Settings → Environment Variables (see SEO.md).

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX)
# Optional: overrides site.gaId in src/data/site.ts
NEXT_PUBLIC_GA_ID=

# Google Search Console — only the content="..." value of the HTML tag method.
# Not needed if you verify the domain via DNS (recommended).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
